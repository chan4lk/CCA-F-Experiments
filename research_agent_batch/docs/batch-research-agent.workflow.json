  "cards": [
    {
      "dot": "cyan",
      "title": "Why there is a loop at all",
      "items": [
        "A batch request is one Messages call: it returns stop_reason tool_use and stops",
        "So this process runs the tool and resubmits; nine researchers x six turns is six batches"
      ]
    },
    {
      "dot": "rose",
      "title": "What the gate can prove",
      "items": [
        "A material claim needs two CONFIRMED rulings from two validators on two models",
        "A validator fetches only the cited URL's host, so it cannot shop for a friendlier source",
        "A cited page absent from the fetch log is the signature of a fabricated citation"
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn",
      "items": [
        "Gap Hunter (opus) reviews the claim set after escalation and can send one more research round, at most two",
        "After the human approves, proposal-writer drafts and the same gate re-runs over the draft"
      ]
    }
  ]
