  "cards": [
    {
      "dot": "cyan",
      "title": "The loop is gone, not rebuilt",
      "items": [
        "A server tool never stops the turn, so a request comes back answered",
        "A phase is one batch; pause_turn is the only continuation"
      ]
    },
    {
      "dot": "rose",
      "title": "Restrictions moved upstream",
      "items": [
        "A validator's web_fetch is pinned to the cited page's host",
        "Validators hold no web_search, so there is nothing to be talked into"
      ]
    },
    {
      "dot": "amber",
      "title": "Provenance is read, not written",
      "items": [
        "Rows come from the response's own web_fetch_tool_result blocks",
        "The fetcher's account, not the model's — it cannot forge one"
      ]
    }
  ]
